    {"type":"text","id":"title","x":40,"y":20,"width":900,"height":60,"text":"Azure Retirement Motion Squad — 19-Step Workflow","fontSize":28,"fontFamily":2,"strokeColor":"#000000","textAlign":"left","verticalAlign":"top"},
    {"type":"text","id":"subtitle","x":40,"y":75,"width":1200,"height":35,"text":"Customer discovery → deliverables → internal motion → approval-gated MSX creation → approval-gated account-team mail","fontSize":16,"fontFamily":2,"strokeColor":"#000000","textAlign":"left","verticalAlign":"top"},

    {"type":"rectangle","id":"s01","x":40,"y":120,"width":260,"height":180,"strokeColor":"#F7630C","backgroundColor":"#FFF4CE","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3}},
    {"type":"text","id":"t01","x":55,"y":138,"width":230,"height":145,"text":"01 · CUSTOMER INTAKE\nHuman checkpoint\nCSA / User\nCustomer, optional TPID, date\n→ intake.md","fontSize":14,"fontFamily":2,"strokeColor":"#000000","textAlign":"center","verticalAlign":"middle"},
    {"type":"rectangle","id":"s02","x":360,"y":120,"width":260,"height":180,"strokeColor":"#0078D4","backgroundColor":"#CFE4FA","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3}},
    {"type":"text","id":"t02","x":375,"y":138,"width":230,"height":145,"text":"02 · RESOLVE CUSTOMER & TPID\nReese Retirement · subagent\nSearch/validate customer identity\nCheck retirement skill version\n→ customer candidates","fontSize":14,"fontFamily":2,"strokeColor":"#000000","textAlign":"center","verticalAlign":"middle"},
    {"type":"rectangle","id":"s03","x":680,"y":120,"width":260,"height":180,"strokeColor":"#F7630C","backgroundColor":"#FFF4CE","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3}},
    {"type":"text","id":"t03","x":695,"y":138,"width":230,"height":145,"text":"03 · CONFIRM CUSTOMER / TPID\nHuman checkpoint\nCSA / User\nSelect exactly one account\n→ confirmed-customer.md","fontSize":14,"fontFamily":2,"strokeColor":"#000000","textAlign":"center","verticalAlign":"middle"},
    {"type":"rectangle","id":"s04","x":1000,"y":120,"width":260,"height":180,"strokeColor":"#0078D4","backgroundColor":"#CFE4FA","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3}},
    {"type":"text","id":"t04","x":1015,"y":138,"width":230,"height":145,"text":"04 · EXTRACT & GENERATE DECK\nReese Retirement · subagent\nCollect and enrich retirements\nClassify urgency + build deck\n→ retirements.json + PPTX","fontSize":14,"fontFamily":2,"strokeColor":"#000000","textAlign":"center","verticalAlign":"middle"},

    {"type":"rectangle","id":"s05","x":1000,"y":400,"width":260,"height":180,"strokeColor":"#F7630C","backgroundColor":"#FFF4CE","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3}},
    {"type":"text","id":"t05","x":1015,"y":418,"width":230,"height":145,"text":"05 · DATA REVIEW\nHuman checkpoint\nCSA / User\nVerify counts, urgency, gaps\nApprove source data + deck","fontSize":14,"fontFamily":2,"strokeColor":"#000000","textAlign":"center","verticalAlign":"middle"},
    {"type":"rectangle","id":"s06","x":680,"y":400,"width":260,"height":180,"strokeColor":"#0078D4","backgroundColor":"#CFE4FA","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3}},
    {"type":"text","id":"t06","x":695,"y":418,"width":230,"height":145,"text":"06 · IMPACTED RESOURCES XLSX\nEthan Excel · subagent\nRead Me + Summary + Resources\nReconcile resource rows\n→ customer workbook","fontSize":14,"fontFamily":2,"strokeColor":"#000000","textAlign":"center","verticalAlign":"middle"},
    {"type":"rectangle","id":"s07","x":360,"y":400,"width":260,"height":180,"strokeColor":"#0078D4","backgroundColor":"#CFE4FA","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3}},
    {"type":"text","id":"t07","x":375,"y":418,"width":230,"height":145,"text":"07 · EXECUTION / MIGRATION PLAN\nRavi Runbook · inline\nScope, steps, validation\nRollback, downtime, effort\n→ customer execution plan","fontSize":14,"fontFamily":2,"strokeColor":"#000000","textAlign":"center","verticalAlign":"middle"},
    {"type":"rectangle","id":"s08","x":40,"y":400,"width":260,"height":180,"strokeColor":"#F7630C","backgroundColor":"#FFF4CE","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3}},
    {"type":"text","id":"t08","x":55,"y":418,"width":230,"height":145,"text":"08 · CUSTOMER DELIVERABLES\nHuman checkpoint\nCSA / User\nApprove deck, XLSX and plan\nReject → responsible step","fontSize":14,"fontFamily":2,"strokeColor":"#000000","textAlign":"center","verticalAlign":"middle"},

    {"type":"rectangle","id":"s09","x":40,"y":680,"width":260,"height":180,"strokeColor":"#0078D4","backgroundColor":"#CFE4FA","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3}},
    {"type":"text","id":"t09","x":55,"y":698,"width":230,"height":145,"text":"09 · MOTION & OPPORTUNITY PLAN\nMorgan Motion · inline\nRevenue vs hygiene motions\nLower/upper ACR assumptions\n→ internal motion plan","fontSize":14,"fontFamily":2,"strokeColor":"#000000","textAlign":"center","verticalAlign":"middle"},
    {"type":"rectangle","id":"s10","x":360,"y":680,"width":260,"height":180,"strokeColor":"#0078D4","backgroundColor":"#CFE4FA","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3}},
    {"type":"text","id":"t10","x":375,"y":698,"width":230,"height":145,"text":"10 · EXECUTIVE BRIEFING\nBianca Briefing · inline\nOne-page leadership brief\nInternal briefing presentation\n→ MD + internal PPTX","fontSize":14,"fontFamily":2,"strokeColor":"#000000","textAlign":"center","verticalAlign":"middle"},
    {"type":"rectangle","id":"s11","x":680,"y":680,"width":260,"height":180,"strokeColor":"#0078D4","backgroundColor":"#CFE4FA","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3}},
    {"type":"text","id":"t11","x":695,"y":698,"width":230,"height":145,"text":"11 · CUSTOMER FOLLOW-UP EMAIL\nFelix Followup · inline\nTop urgent retirements\nConsultative next action\n→ customer email draft","fontSize":14,"fontFamily":2,"strokeColor":"#000000","textAlign":"center","verticalAlign":"middle"},
    {"type":"rectangle","id":"s12","x":1000,"y":680,"width":260,"height":180,"strokeColor":"#5C2D91","backgroundColor":"#E8DAEF","fillStyle":"solid","strokeWidth":3,"roundness":{"type":3}},
    {"type":"text","id":"t12","x":1015,"y":698,"width":230,"height":145,"text":"12 · READ-ONLY MSX PROPOSAL\nMoxie MSX · inline\nResolve IDs, MAL owner, dates\nBuild exact payload + hash\nZERO MSX WRITES","fontSize":14,"fontFamily":2,"strokeColor":"#000000","textAlign":"center","verticalAlign":"middle"},

    {"type":"rectangle","id":"s13","x":1000,"y":960,"width":260,"height":180,"strokeColor":"#107C10","backgroundColor":"#DFF6DD","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3}},
    {"type":"text","id":"t13","x":1015,"y":978,"width":230,"height":145,"text":"13 · QUALITY REVIEW\nQuinn Quality · inline\nValidate all artifacts + proposal\nPASS or precise loop-back\n→ review-verdict.md","fontSize":14,"fontFamily":2,"strokeColor":"#000000","textAlign":"center","verticalAlign":"middle"},
    {"type":"rectangle","id":"s14","x":680,"y":960,"width":260,"height":180,"strokeColor":"#F7630C","backgroundColor":"#FFF4CE","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3}},
    {"type":"text","id":"t14","x":695,"y":978,"width":230,"height":145,"text":"14 · FINAL DELIVERABLES\nHuman checkpoint\nCSA / User\nApprove package quality\nNOT MSX authorization","fontSize":14,"fontFamily":2,"strokeColor":"#000000","textAlign":"center","verticalAlign":"middle"},
    {"type":"rectangle","id":"s15","x":360,"y":960,"width":260,"height":180,"strokeColor":"#D13438","backgroundColor":"#FDE7E9","fillStyle":"solid","strokeWidth":3,"roundness":{"type":3}},
    {"type":"text","id":"t15","x":375,"y":978,"width":230,"height":145,"text":"15 · MSX CREATION APPROVAL\nHuman checkpoint\nCSA / User\nAPPROVE / SKIP / REVISE\nExact proposal hash required","fontSize":14,"fontFamily":2,"strokeColor":"#000000","textAlign":"center","verticalAlign":"middle"},
    {"type":"rectangle","id":"s16","x":40,"y":960,"width":260,"height":180,"strokeColor":"#5C2D91","backgroundColor":"#E8DAEF","fillStyle":"solid","strokeWidth":3,"roundness":{"type":3}},
    {"type":"text","id":"t16","x":55,"y":978,"width":230,"height":145,"text":"16 · COMMIT MSX RECORDS\nMoxie MSX · inline\nCreate once, receipt each write\nReadback + retry-safe finalize\n→ creation receipt","fontSize":14,"fontFamily":2,"strokeColor":"#000000","textAlign":"center","verticalAlign":"middle"},

    {"type":"rectangle","id":"s17","x":40,"y":1240,"width":260,"height":180,"strokeColor":"#0C8599","backgroundColor":"#99E9F2","fillStyle":"solid","strokeWidth":3,"roundness":{"type":3}},
    {"type":"text","id":"t17","x":55,"y":1258,"width":230,"height":145,"text":"17 · READ-ONLY MAIL PROPOSAL\nMaurice Mailing · inline\nResolve MAL recipients + MSX links\nExport Top Revenue Motions PNG\nZERO MAILBOX WRITES","fontSize":14,"fontFamily":2,"strokeColor":"#000000","textAlign":"center","verticalAlign":"middle"},
